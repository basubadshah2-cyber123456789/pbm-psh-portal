# ERP database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ERP session signing: set a unique random value with at least 32 characters.
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# Public application metadata
NEXT_PUBLIC_APP_NAME="Pakistan Bait-ul-Maal Sweet Home Multan"
NEXT_PUBLIC_APP_LOCATION="Multan, Punjab, Pakistan"
NEXT_PUBLIC_APP_URL="https://your-portal.vercel.app"

# Private child-photo storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Separate PBM child portal database and authentication
PBM_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PBM_SESSION_SECRET="replace-with-a-separate-random-secret-of-at-least-32-characters"
PBM_SETUP_KEY="replace-with-a-separate-high-entropy-setup-key"

# Set these only when deliberately creating or refreshing seeded ERP accounts.
SEED_ADMIN_PASSWORD="set-a-unique-strong-password"
SEED_ACCOUNTS_PASSWORD="set-a-unique-strong-password"
SEED_STAFF_PASSWORD="set-a-unique-strong-password"

# Weekly-off SMS gateway (server-side only)
CRON_SECRET="replace-with-a-random-cron-secret"
SMS_GATEWAY_ENABLED="false"
SMS_GATEWAY_URL="https://your-sms-gateway.example/send"
SMS_GATEWAY_API_KEY="server-only-gateway-key"
SMS_GATEWAY_DEVICE_ID="dedicated-device-id"
SMS_GATEWAY_TIMEOUT_MS="15000"
